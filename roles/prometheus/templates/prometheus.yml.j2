global:
  scrape_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Built dynamically from the live inventory: every host in these
  # groups is assumed to be running the node_exporter role.
  - job_name: node
    static_configs:
      - targets:
{% for group in ['webservers', 'appservers', 'dbservers', 'dockerhosts', 'monitoring'] %}
{% for host in groups[group] | default([]) %}
          - "{{ hostvars[host].ansible_host | default(host) }}:9100"
{% endfor %}
{% endfor %}
