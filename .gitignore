*.retry
*.log

# Vault password files - never commit these. The group_vars/*/vault.yml
# files themselves ARE committed on purpose: they're ansible-vault
# encrypted at rest, which is the whole point of using vault.
.vault_pass*
*.vault_pass
secrets.yml
*.pem
*.key

# Inventory overrides that may contain host-specific secrets
inventory/host_vars/*.local.yml
inventory/group_vars/*.local.yml

# Ansible artifacts
.ansible/
ansible.log
*.retry

# Molecule
.cache/
molecule/*/molecule.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.DS_Store
.idea/
.vscode/
